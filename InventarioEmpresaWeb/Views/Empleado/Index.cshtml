@model List<Empleado>
@{
    ViewData["Title"] = "Empleados";
}

<h2>Empleados</h2>
<p><a class="btn btn-primary" asp-action="Create">+ Nuevo empleado</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>DNI</th>
            <th>Cargo</th>
            <th>Área</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var emp in Model)
    {
        <tr>
            <td>@emp.Nombre</td>
            <td>@emp.Dni</td>
            <td>@emp.Cargo</td>
            <td>@emp.AreaNombre</td>
            <td>
                <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@emp.Id">Editar</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@emp.Id">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
